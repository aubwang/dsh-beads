{
  "name": "@aubwang/dsh-beads",
  "description": "Durable work ledger for DeepSeek Harness agents, backed by the beads (`bd`) CLI: model-facing bead_* tools over a git-backed issue graph with typed dependencies, atomic claims, and close-time verification",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./bd-cli": {
      "types": "./lib/types/bd-cli.d.ts",
      "default": "./lib/bd-cli.js"
    },
    "./packet": {
      "types": "./lib/types/packet.d.ts",
      "default": "./lib/packet.js"
    },
    "./render": {
      "types": "./lib/types/render.d.ts",
      "default": "./lib/render.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test"
  },
  "peerDependencies": {
    "@aubwang/dsh-consult": "^0.1.0",
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.7",
    "@deepseek-ai/dsh-sandbox": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "0.1.0-rc.7",
    "@deepseek-ai/dsh-shell": "0.1.0-rc.7",
    "@deepseek-ai/dsh-subprocess": "0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.7",
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-shell": {
      "optional": true
    },
    "@deepseek-ai/dsh-sandbox": {
      "optional": true
    },
    "@aubwang/dsh-consult": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aubwang/dsh-consult": "link:../dsh-consult",
    "@deepseek-ai/cordis": "link:../dev/deepseek-harness/vendor/cordis",
    "@deepseek-ai/dsh-agent": "link:../dev/deepseek-harness/packages/core/agent",
    "@deepseek-ai/dsh-bash-local": "link:../dev/deepseek-harness/packages/shell/bash-local",
    "@deepseek-ai/dsh-llm": "link:../dev/deepseek-harness/packages/llm/llm",
    "@deepseek-ai/dsh-sandbox": "link:../dev/deepseek-harness/packages/sandbox/sandbox",
    "@deepseek-ai/dsh-sandbox-local": "link:../dev/deepseek-harness/packages/sandbox/sandbox-local",
    "@deepseek-ai/dsh-session": "link:../dev/deepseek-harness/packages/core/session",
    "@deepseek-ai/dsh-shell": "link:../dev/deepseek-harness/packages/shell/shell",
    "@deepseek-ai/dsh-subprocess": "link:../dev/deepseek-harness/packages/subprocess/subprocess",
    "@deepseek-ai/dsh-subprocess-local": "link:../dev/deepseek-harness/packages/subprocess/subprocess-local",
    "@deepseek-ai/dsh-system-prompt": "link:../dev/deepseek-harness/packages/core/system-prompt",
    "@deepseek-ai/dsh-tools": "link:../dev/deepseek-harness/packages/core/tools",
    "@deepseek-ai/schemastery": "link:../dev/deepseek-harness/vendor/schemastery",
    "@types/node": "^24.0.0",
    "typescript": "6.0.3"
  }
}
